on fs
    chmod 0664 /sys/class/thermal/thermal_message/screen_state
    chown system system /sys/class/thermal/thermal_message/screen_state
    chmod 0666 /sys/class/power_supply/battery/charge_control_limit
    chown system system /sys/class/power_supply/battery/charge_control_limit
    chmod 0666 /sys/class/qcom-battery/restrict_chg
    chown system system /sys/class/qcom-battery/restrict_chg
    chmod 0666 /sys/class/qcom-battery/restrict_cur
    chown system system /sys/class/qcom-battery/restrict_cur
    chmod 0666 /sys/class/thermal/thermal_zone34/temp
    chown system system /sys/class/thermal/thermal_zone34/temp

on boot
    start mi_thermald

on charger
    start mi_thermald

service mi_thermald /system/vendor/bin/mi_thermald
    class main
    user root
    group system
    seclabel u:r:mi_thermald:s0